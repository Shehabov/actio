{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orchestrator",
  "enabledMcpjsonServers": [
    "supabase",
    "playwright",
    "vercel"
  ],
  "permissions": {
    "allow": [
      "Read(//**)",
      "Glob(//**)",
      "Grep(//**)",
      "Write(.actio/**)",
      "Edit(.actio/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(find:*)",
      "Bash(date:*)",
      "Bash(mkdir:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npx --version)",
      "Bash(node .actio/bin/*)",
      "Bash(node .actio/bin/sync-gates.mjs:*)",
      "Bash(node .actio/bin/utilisation-check.mjs:*)",
      "Bash(node .actio/bin/db-test.mjs:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm audit:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx create-next-app:*)",
      "Bash(curl:*)",
      "mcp__supabase__search_docs",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_extensions",
      "mcp__supabase__list_migrations",
      "mcp__supabase__apply_migration",
      "mcp__supabase__execute_sql",
      "mcp__supabase__get_logs",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_project_url",
      "mcp__supabase__get_publishable_keys",
      "mcp__supabase__get_anon_key",
      "mcp__supabase__generate_typescript_types",
      "mcp__supabase__list_edge_functions",
      "mcp__supabase__get_edge_function",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__list_branches",
      "mcp__supabase__list_storage_buckets",
      "mcp__supabase__get_storage_config",
      "mcp__supabase__get_project",
      "mcp__playwright",
      "Bash(claude mcp list:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh pr:*)",
      "Bash(gh release:*)",
      "Bash(npm publish:*)",
      "mcp__supabase__create_branch",
      "mcp__supabase__delete_branch",
      "mcp__supabase__merge_branch",
      "mcp__supabase__reset_branch",
      "mcp__supabase__rebase_branch",
      "mcp__supabase__update_storage_config",
      "mcp__supabase__pause_project",
      "mcp__supabase__restore_project",
      "mcp__supabase__create_project",
      "mcp__supabase__confirm_cost",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_drop",
      "Write(.actio/bin/**)",
      "Edit(.actio/bin/**)",
      "mcp__vercel"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env*)",
      "Read(./**/secrets/**)",
      "mcp__playwright__browser_run_code_unsafe",
      "Read(~/.claude/.credentials.json)",
      "mcp__vercel__create_api_keys",
      "mcp__vercel__exchange_sso_token",
      "mcp__vercel__buy_addon",
      "mcp__vercel__buy_credits",
      "mcp__vercel__buy_credits_endpoint",
      "mcp__vercel__buy_domain",
      "mcp__vercel__buy_pro",
      "mcp__vercel__get_access_to_vercel_url",
      "mcp__vercel__buy_domains",
      "mcp__vercel__buy_single_domain",
      "mcp__vercel__create_drain",
      "mcp__vercel__test_drain",
      "mcp__vercel__update_drain",
      "mcp__vercel__filter_project_envs",
      "mcp__vercel__get_project_env",
      "mcp__vercel__get_shared_env_var",
      "mcp__vercel__create_sdk_key",
      "mcp__vercel__list_feature_flag_sdk_keys",
      "mcp__vercel__create_edge_config_token",
      "mcp__vercel__create_kms_signing_key",
      "mcp__vercel__sign_kms_message",
      "mcp__vercel__sign_kms_token",
      "mcp__vercel__accept_project_transfer_request",
      "mcp__vercel__get_project_token",
      "mcp__vercel__update_project_protection_bypass",
      "mcp__vercel__patch_url_protection_bypass",
      "mcp__vercel__create_sandboxes_v2",
      "mcp__vercel__create_sandboxes_v3",
      "mcp__vercel__create_sandboxes_v4",
      "mcp__vercel__run_session_command",
      "mcp__vercel__update_session_network_policy",
      "mcp__vercel__write_session_files",
      "mcp__vercel__join_team"
    ]
  },
  "env": {
    "ACTIO_RUNS_DIR": ".actio/runs"
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.actio/bin/ledger-hook.mjs\" start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.actio/bin/ledger-hook.mjs\" stop"
          }
        ]
      }
    ]
  }
}
