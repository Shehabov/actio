{
  "version": 1,
  "about": "The closed surface vocabulary for BUGS.md, read by .actio/bin/bugs.mjs. A changed path carries every tag whose globs match it. kind decides product against machinery: a product run never receives a machinery entry. derive false means an entry gets the tag only by declaring it in its Surfaces row, so a catch-all tag never drags every entry into every brief. Globs are repo-relative, forward slashes, ** for any depth, * within one segment.",
  "tags": {
    "web": { "kind": "product", "globs": ["web/**", ".claude/agents/frontend-engineer.md"] },
    "extension": { "kind": "product", "globs": ["extension/**"] },
    "db": { "kind": "product", "globs": ["supabase/**", ".actio/bin/db-test*", ".claude/skills/actio-supabase/**", ".claude/agents/backend-engineer.md"] },
    "privacy": { "kind": "product", "globs": ["supabase/migrations/**", "supabase/tests/**", "supabase/functions/**", ".claude/skills/actio-supabase/**", ".claude/skills/actio-architecture/**", ".claude/skills/actio-test-protocol/**", ".claude/agents/backend-engineer.md", ".claude/agents/tech-architect.md"] },
    "api": { "kind": "product", "globs": ["supabase/functions/**", "web/src/app/api/**", "web/app/api/**", "web/src/lib/api/**", "web/src/lib/supabase/**"] },
    "reporting": { "kind": "product", "globs": ["supabase/**/*report*", "supabase/**/*cohort*", "supabase/**/*insight*", "web/src/**/report*/**", "web/src/**/insight*/**", "web/app/**/report*/**", "web/app/**/insight*/**"] },
    "issues": { "kind": "product", "globs": ["supabase/**/*issue*", "supabase/**/*evidence*", "web/src/**/issue*/**", "web/src/**/queue/**", "web/app/**/issue*/**", "web/app/**/queue/**"] },
    "config": { "kind": "product", "globs": ["web/*.config.*", "web/middleware.ts", "web/src/middleware.ts", "extension/*.config.*", "extension/manifest.json", "extension/public/manifest.json", "supabase/config.toml", "**/.env*"] },
    "copy": { "kind": "product", "globs": ["content/strings/**", ".claude/skills/actio-bilingual-copy/**", ".claude/agents/ux-writer.md"] },
    "design": { "kind": "product", "globs": ["design/**", "docs/design-reference/**", ".claude/skills/actio-design-system/**", ".claude/skills/actio-ux-audit/**", ".claude/agents/ux-designer.md", ".claude/agents/ux-auditor.md", "web/src/**/*.css", "web/app/**/*.css", "extension/src/**/*.css"] },
    "brand": { "kind": "product", "globs": ["BRAND.md", "Actio-Brand-Guidelines-v1.pdf", ".claude/skills/actio-brand-guard/**", "logo/**", "**/*.svg"] },
    "architecture": { "kind": "product", "globs": ["docs/architecture/**", "docs/adr/**", ".claude/skills/actio-architecture/**", ".claude/agents/tech-architect.md"] },
    "orchestration": { "kind": "machinery", "globs": ["docs/WORKFLOW.md", "docs/TEAM.md", ".claude/agents/orchestrator.md", ".claude/skills/actio-orchestration/**", ".actio/bin/utilisation-check.mjs", ".actio/bin/sync-gates.mjs", ".actio/bin/run.mjs", ".actio/bin/ledger-hook.mjs", ".actio/TEMPLATE/lanes/**"] },
    "protocol": { "kind": "machinery", "globs": [".claude/skills/actio-agent-protocol/**", ".actio/TEMPLATE/**", ".actio/README.md"] },
    "register": { "kind": "machinery", "globs": ["BUGS.md", ".claude/agents/bug-historian.md", ".claude/skills/actio-bug-register/**", ".actio/bugs/**", ".actio/bin/bugs*.mjs"] },
    "permissions": { "kind": "machinery", "globs": [".claude/settings.json", ".claude/settings.local.json", ".mcp.json"] },
    "release": { "kind": "machinery", "globs": [".claude/agents/release-engineer.md", ".claude/skills/actio-release/**"] },
    "review": { "kind": "machinery", "globs": [".claude/agents/peer-reviewer.md", ".claude/agents/code-analyst.md", ".claude/agents/code-steward.md", ".claude/agents/security-analyst.md", ".claude/skills/actio-code-review/**", ".claude/skills/actio-code-analysis/**", ".claude/skills/actio-clean-code/**", ".claude/skills/actio-security/**"] },
    "qa": { "kind": "machinery", "globs": [".claude/agents/qc-engineer.md", ".claude/agents/qc-lead.md", ".claude/skills/actio-test-protocol/**", ".actio/bin/verify.mjs"] },
    "tooling": { "kind": "machinery", "globs": [".actio/bin/**", "package.json", "package-lock.json", ".gitignore", ".gitattributes"] },
    "repo-docs": { "kind": "machinery", "globs": ["CLAUDE.md", "README.md", "docs/**"] },
    "agent-defs": { "kind": "machinery", "derive": false, "globs": [".claude/agents/**", ".claude/skills/*/SKILL.md", ".agents/skills/**", "skills-lock.json"] }
  },
  "ui_tags": ["web", "extension", "design", "copy", "brand"],
  "aliases": {
    "about": "Today's free-text Surface cells and Component tokens, mapped to tags, so no entry needs editing. A key ending in * matches by prefix. Each comma-separated part of a Surface cell is looked up; a part equal to a tag name is that tag. An empty list means the part is a file type, not a surface, and the Component cell decides.",
    "orchestration": ["orchestration"],
    "design system": ["design"],
    ".claude/skills": [],
    ".claude": [],
    ".claude/": ["agent-defs", "permissions"],
    "logo": ["brand"],
    "docs": ["repo-docs"],
    "api/reports": ["db", "privacy", "reporting", "api"],
    "brand.md": ["brand"],
    "brand spec": ["brand"],
    "bugs.md": ["register"],
    "tooling": ["tooling"],
    "gate table": ["orchestration", "repo-docs"],
    "back-end doctrine*": ["db", "privacy"],
    "privacy invariant*": ["privacy"],
    "test protocol*": ["qa", "privacy"]
  },
  "class_tags": {
    "about": "A3: an entry is selected when its surface tags OR the tags its Class maps to intersect the run's tags. A machinery entry is still never selected for a run with no machinery tag. agent-behaviour entries never appear as rows; the universal rules cover them.",
    "privacy-invariant": ["db", "privacy", "reporting", "api"],
    "state-machine": ["db", "issues"],
    "security": ["db", "api", "config", "permissions"],
    "data-layer": ["db"],
    "contract": ["api", "db"],
    "brand": ["web", "extension", "design", "copy", "brand"],
    "design-system": ["web", "extension", "design", "copy", "brand"],
    "locale": ["web", "extension", "design", "copy", "brand"],
    "accessibility": ["web", "extension", "design", "copy", "brand"],
    "correctness": [],
    "process": [],
    "agent-behaviour": []
  },
  "entry_tags": {
    "about": "Tags added to a legacy entry whose Surface and Component cells miss a surface it binds (bugs-analysis section 5). Retired entry by entry when the record pass gives that entry a Surfaces row.",
    "BUG-0004": ["orchestration"],
    "BUG-0020": ["privacy"]
  }
