{
  "version": 1,
  "about": "The closed surface vocabulary for BUGS.md, read by .actio/bin/bugs.mjs. A changed path carries every tag whose globs match it. Every tag is product code under web/, extension/ or supabase/, or shipped content. Globs are repo-relative, forward slashes, ** for any depth, * within one segment.",
  "tags": {
    "web": {
      "kind": "product",
      "globs": [
        "web/**"
      ]
    },
    "extension": {
      "kind": "product",
      "globs": [
        "extension/**"
      ]
    },
    "db": {
      "kind": "product",
      "globs": [
        "supabase/**"
      ]
    },
    "privacy": {
      "kind": "product",
      "globs": [
        "supabase/migrations/**",
        "supabase/tests/**",
        "supabase/functions/**"
      ]
    },
    "api": {
      "kind": "product",
      "globs": [
        "supabase/functions/**",
        "web/src/app/api/**",
        "web/app/api/**",
        "web/src/lib/api/**",
        "web/src/lib/supabase/**"
      ]
    },
    "reporting": {
      "kind": "product",
      "globs": [
        "supabase/**/*report*",
        "supabase/**/*cohort*",
        "supabase/**/*insight*",
        "web/src/**/report*/**",
        "web/src/**/insight*/**",
        "web/app/**/report*/**",
        "web/app/**/insight*/**"
      ]
    },
    "issues": {
      "kind": "product",
      "globs": [
        "supabase/**/*issue*",
        "supabase/**/*evidence*",
        "web/src/**/issue*/**",
        "web/src/**/queue/**",
        "web/app/**/issue*/**",
        "web/app/**/queue/**"
      ]
    },
    "config": {
      "kind": "product",
      "globs": [
        "web/*.config.*",
        "web/middleware.ts",
        "web/src/middleware.ts",
        "extension/*.config.*",
        "extension/manifest.json",
        "extension/public/manifest.json",
        "supabase/config.toml",
        "**/.env*"
      ]
    },
    "copy": {
      "kind": "product",
      "globs": [
        "content/strings/**"
      ]
    },
    "design": {
      "kind": "product",
      "globs": [
        "design/**",
        "web/src/**/*.css",
        "web/app/**/*.css",
        "extension/src/**/*.css"
      ]
    },
    "brand": {
      "kind": "product",
      "globs": [
        "BRAND.md",
        "Actio-Brand-Guidelines-v1.pdf",
        "logo/**",
        "**/*.svg"
      ]
    }
  },
  "ui_tags": [
    "web",
    "extension",
    "design",
    "copy",
    "brand"
  ],
  "aliases": {
    "about": "Free-text Surface cells and Component tokens mapped to tags. A key ending in * matches by prefix.",
    "design system": [
      "design"
    ],
    "logo": [
      "brand"
    ],
    "api/reports": [
      "db",
      "privacy",
      "reporting",
      "api"
    ],
    "brand.md": [
      "brand"
    ],
    "brand spec": [
      "brand"
    ],
    "back-end doctrine*": [
      "db",
      "privacy"
    ],
    "privacy invariant*": [
      "privacy"
    ]
  },
  "class_tags": {
    "about": "An entry is selected when its surface tags OR the tags its Class maps to intersect the run's tags.",
    "privacy-invariant": [
      "db",
      "privacy",
      "reporting",
      "api"
    ],
    "state-machine": [
      "db",
      "issues"
    ],
    "security": [
      "db",
      "api",
      "config"
    ],
    "data-layer": [
      "db"
    ],
    "contract": [
      "api",
      "db"
    ],
    "brand": [
      "web",
      "extension",
      "design",
      "copy",
      "brand"
    ],
    "design-system": [
      "web",
      "extension",
      "design",
      "copy",
      "brand"
    ],
    "locale": [
      "web",
      "extension",
      "design",
      "copy",
      "brand"
    ],
    "accessibility": [
      "web",
      "extension",
      "design",
      "copy",
      "brand"
    ],
    "correctness": []
  }
}
