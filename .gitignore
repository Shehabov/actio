# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.swp

# Node
node_modules/

# Environment. Keys never reach the repo, and that includes web/.env.local, which holds the
# project URL and publishable key. .env.example is the committed template.
.env
.env.*
!.env.example
*.pem

# Next.js, Playwright and coverage output. .next/ matches at any depth; web/.next/ is named
# so the app's build folder is visibly covered. next-env.d.ts is regenerated by next dev and
# next build, and Next.js asks for it to stay out of version control.
.next/
web/.next/
next-env.d.ts
*.tsbuildinfo
playwright-report/
test-results/
coverage/
# The Playwright MCP server writes captures that carry no file name to .playwright-mcp/ in its
# working directory, the repository root. Evidence is saved by name under .actio/runs/ instead.
.playwright-mcp/

# Temp and build artifacts
*.tmp
*.log
.~lock.*#
build/
dist/

# Generated raster exports (the vectors are the source of truth)
logo/**/*.png


# Supabase agent skills: `npx skills add supabase/agent-skills` writes the real files to
# .agents/skills/ (committed) and symlinks them into .claude/skills/ with an absolute
# machine-local path, which breaks on any other clone. Ignore the symlinks, keep the source.
.claude/skills/supabase
.claude/skills/supabase-postgres-best-practices

# God-mode test run artefacts. Kept locally; the register carries the findings.
.actio/runs/
.actio/verify/
